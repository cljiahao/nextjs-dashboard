# ─── Database (Vercel Postgres / Neon) ────────────────────────────────
# Get these from your Postgres provider's dashboard (Vercel Storage or Neon).
# Pooled connection string (app runtime).
POSTGRES_URL=
# Pooled URL for Prisma (includes pgbouncer/connection_limit params).
POSTGRES_PRISMA_URL=
# Direct, non-pooled connection string (migrations).
POSTGRES_URL_NON_POOLING=
# Connection string without SSL (local dev only).
POSTGRES_URL_NO_SSL=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Neon-style aliases for the same database (used by some libraries).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGDATABASE=
PGPASSWORD=

# ─── Auth.js / NextAuth v5 ────────────────────────────────────────────
# Random 32+ char secret. Generate with:  openssl rand -base64 32
AUTH_SECRET=
# Base auth URL, e.g. http://localhost:3000/api/auth
AUTH_URL=
